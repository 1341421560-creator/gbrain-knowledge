  "rules": [
    "五档采用同一个缩放系数；宽高同时缩放",
    "真实手机素材保留原始宽高比，以对应档位的目标高度对齐；模板宽度作为排版参考",
    "相近尺寸保持小幅差异；6.7相对6.1高10%，6.9相对6.1高13.33%",
    "同排机身底部对齐；摄像头、勾叉随机身同步缩放",
    "画布改变时整组调整缩放系数，不逐台随卡片空位自由放大"
  ],
  "scale_formula": {
    "width": "模板宽度 × 统一缩放系数",
